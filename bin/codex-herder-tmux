#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
socket_path="$repo_root/.codex_herder/tmux/codex-herder.sock"

if [[ ! -S "$socket_path" ]]; then
  if [[ "${1:-}" == "ls" || "${1:-}" == "list-sessions" ]]; then
    exit 0
  fi
fi

exec tmux -S "$socket_path" "$@"
